{
  "_note": "worklog 개인화 프로필 예시. ~/.config/mccm/worklog.json 으로 복사한 뒤 값을 채운다. 토큰·서버 주소·로그인 이메일은 넣지 않는다(JIRA_API_TOKEN env / ~/.config/.jira/.config.yml 이 각각 담당). sync:true 로 두면 /upload 가 mccm env gist 에 함께 올린다 — gist 의 secret 은 'URL 을 아는 누구나 열람'이지 비공개가 아니다.",
  "version": 1,
  "sync": false,
  "identity": {
    "display_name": "Your Name",
    "report_destination": "문서 도구"
  },
  "examples": {
    "issue_keys": ["ABC-101", "ABC-102"],
    "topics": [
      "{주제 1} — {한 줄 설명}",
      "{주제 2} — {한 줄 설명}"
    ]
  },
  "report": {
    "comment_style": "'- ' 불릿, 결과 중심 한 줄.",
    "weekly_style": "이슈별로 묶고 시간 많은 순.",
    "project_names": {
      "PROJ-A": "{프로젝트 A 정식 명칭}",
      "PROJ-B": "{프로젝트 B 정식 명칭}"
    },
    "template": [
      "■ {프로젝트 표시명}",
      "  1. {작업 서술} ({M/D} 또는 {~M/D})",
      "      ◦ {세부 결과}",
      "",
      "■ 경상",
      "  1. {워크로그 서술} ({M/D})"
    ]
  }
}
