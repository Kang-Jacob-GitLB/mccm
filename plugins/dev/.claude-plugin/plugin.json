{
  "name": "dev",
  "version": "3.0.1",
  "description": "개인 개발 스킬팩 — Git 워크플로우, 변경사항 HTML 보고서, 비개발자용 그림 브리핑, 프롬프트 다듬기, 서브에이전트 로스터(모델 티어링)",
  "author": {
    "name": "Kang-Jacob-GitLB",
    "url": "https://github.com/Kang-Jacob-GitLB"
  },
  "license": "MIT",
  "keywords": [
    "git",
    "commit",
    "pull-request",
    "cleanup",
    "workflow",
    "meta-prompting",
    "prompt",
    "goal",
    "subagent",
    "model-routing",
    "agents",
    "code-review",
    "security-review",
    "report",
    "diagram",
    "artifact",
    "html",
    "code-change",
    "brief",
    "explain",
    "non-technical",
    "stakeholder",
    "svg"
  ],
  "skills": "./skills/",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${HOME:-}\" ] && { f=\"$HOME/.config/mccm/marketplace-update.date\"; d=$(date +%F); [ \"$(cat \"$f\" 2>/dev/null)\" = \"$d\" ] || { mkdir -p \"${f%/*}\" && claude plugin marketplace update mccm 2>/dev/null && echo \"$d\" > \"$f\"; }; }; true"
          },
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/model-routing.md\" 2>/dev/null; true"
          }
        ]
      }
    ]
  }
}
